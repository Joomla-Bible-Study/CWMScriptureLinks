{
    "extension": {
        "type": "package",
        "name": "pkg_cwmscripture"
    },
    "profile": "package-wrapper",
    "manifests": {
        "_comment": "Sub-extensions are versioned independently: the library lives in its own submodule/repo and bumps on its own cadence (lib v1.1.3 != package v1.1.4); the plugins only bump when their code actually changes. cwm-bump from this repo therefore only touches the package wrapper manifest below. To bump the library, run the bump from its own repo; to bump a plugin, edit its manifest directly.",
        "package": "build/pkg_cwmscripture.xml",
        "extensions": []
    },
    "build": {
        "command":    "cwm-package",
        "outputGlob": "build/dist/pkg_cwmscripture-*.zip"
    },
    "package": {
        "manifest":    "build/pkg_cwmscripture.xml",
        "outputDir":   "build/dist",
        "outputName":  "pkg_cwmscripture-{version}.zip",
        "innerLayout": "root",
        "installer":   "build/script.install.php",
        "includes": [
            {
                "type":       "prebuilt",
                "distGlob":   "libraries/lib_cwmscripture/build/dist/lib_cwmscripture-*.zip",
                "outputName": "lib_cwmscripture.zip"
            },
            {
                "type":       "inline",
                "outputName": "plg_content_scripturelinks.zip",
                "config": {
                    "outputDir":  "build/dist",
                    "outputName": "plg_content_scripturelinks.zip",
                    "manifest":   "scripturelinks.xml",
                    "scriptFile": "script.php",
                    "sources": [
                        { "from": "src",      "to": "src" },
                        { "from": "services", "to": "services" },
                        { "from": "language", "to": "language" },
                        { "from": "tmpl",     "to": "tmpl" }
                    ],
                    "excludes": [".git", ".DS_Store", ".idea", "node_modules"]
                }
            },
            {
                "type":       "inline",
                "outputName": "plg_task_cwmscripture.zip",
                "config": {
                    "outputDir":  "build/dist",
                    "outputName": "plg_task_cwmscripture.zip",
                    "manifest":   "plg_task_cwmscripture/cwmscripture.xml",
                    "scriptFile": "plg_task_cwmscripture/script.php",
                    "sources": [
                        { "from": "plg_task_cwmscripture/src",      "to": "src" },
                        { "from": "plg_task_cwmscripture/services", "to": "services" },
                        { "from": "plg_task_cwmscripture/language", "to": "language" }
                    ],
                    "excludes": [".git", ".DS_Store", ".idea", "node_modules"]
                }
            },
            {
                "type":       "inline",
                "outputName": "plg_system_cwmscripture.zip",
                "config": {
                    "outputDir":  "build/dist",
                    "outputName": "plg_system_cwmscripture.zip",
                    "manifest":   "plg_system_cwmscripture/cwmscripture.xml",
                    "sources": [
                        { "from": "plg_system_cwmscripture/src",      "to": "src" },
                        { "from": "plg_system_cwmscripture/services", "to": "services" },
                        { "from": "plg_system_cwmscripture/language", "to": "language" }
                    ],
                    "excludes": [".git", ".DS_Store", ".idea", "node_modules"]
                }
            }
        ],
        "verify": {
            "expectedEntries": [
                "pkg_cwmscripture.xml",
                "script.install.php",
                "lib_cwmscripture.zip",
                "plg_content_scripturelinks.zip",
                "plg_task_cwmscripture.zip",
                "plg_system_cwmscripture.zip"
            ]
        }
    },
    "ars": {
        "endpoint": "https://www.christianwebministries.org",
        "categoryId": 5,
        "updateStreamId": 4,
        "environments": ["45", "46", "48", "49", "50"],
        "tokenItem": "CWM ARS API Token",
        "tokenVault": "CWM",
        "itemDescription": "CWM Scripture Links package — bundles the shared scripture library, the content plugin that processes {scripture}/{bible} tags in Joomla articles, and the task plugin for background translation downloads."
    },
    "_versionTracking_comment": "Override on top of the 'package-wrapper' profile. Lists replace wholesale, so paths fully redefines the scan roots (profile default is just src/ + language/).",
    "versionTracking": {
        "substituteTokens": {
            "paths": ["libraries/", "src/", "plg_task_cwmscripture/"]
        }
    },
    "github": {
        "owner": "Joomla-Bible-Study",
        "repo": "CWMScriptureLinks",
        "releaseBranch": "main"
    },
    "changelog": {
        "file": "build/cwmscripture-changelog.xml",
        "url":  "https://raw.githubusercontent.com/Joomla-Bible-Study/CWMScriptureLinks/main/build/cwmscripture-changelog.xml"
    }
}
