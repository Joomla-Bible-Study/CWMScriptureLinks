<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">
    <name>pkg_cwmscripture</name>
    <packagename>cwmscripture</packagename>
    <author>CWM Team</author>
    <creationDate>2026-08-13</creationDate>
    <copyright>(C) 2026 CWM Team All rights reserved</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>info@christianwebministries.org</authorEmail>
    <authorUrl>https://www.christianwebministries.org</authorUrl>
    <version>1.2.4</version>
    <description>CWM Scripture package: Bible provider library, content plugin for automatic scripture linking, and task plugin for deferred background scripture work.</description>

    <scriptfile>script.install.php</scriptfile>

    <!--
        Children may not be uninstalled individually. lib_cwmscripture is a
        dependency of the plugins shipped here (and of com_proclaim), so pulling
        it out on its own leaves them calling classes that no longer exist.
        Matches pkg_proclaim.xml.
    -->
    <blockChildUninstall>true</blockChildUninstall>

    <changelogurl>https://raw.githubusercontent.com/Joomla-Bible-Study/CWMScriptureLinks/main/build/cwmscripture-changelog.xml</changelogurl>

    <updateservers>
        <server type="extension" name="CWM Scripture Package">https://www.christianwebministries.org/index.php?option=com_ars&amp;view=update&amp;task=stream&amp;format=xml&amp;id=4&amp;dummy=extension.xml</server>
    </updateservers>

    <files>
        <!-- Library installs first (order matters) -->
        <file type="library" id="cwmscripture">lib_cwmscripture.zip</file>
        <file type="plugin" group="content" id="scripturelinks">plg_content_scripturelinks.zip</file>
        <file type="plugin" group="task" id="cwmscripture">plg_task_cwmscripture.zip</file>
        <file type="plugin" group="system" id="cwmscripture">plg_system_cwmscripture.zip</file>
    </files>
</extension>
