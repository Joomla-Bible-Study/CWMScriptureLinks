{
  "name": "cwm/scripture-library",
  "description": "CWM Scripture Library - Shared Bible provider library and content plugin for Joomla 5/6",
  "type": "joomla-package",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.christianwebministries.org",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "CWM\\Library\\Scripture\\": "lib_cwmscripture/src/",
      "CWM\\Plugin\\Content\\ScriptureLinks\\": "plg_content_scripturelinks/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CWM\\Library\\Scripture\\Tests\\": "tests/unit/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "build": "php build/build.php"
  }
}
